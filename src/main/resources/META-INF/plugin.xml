<idea-plugin>
    <!--
      NixIDEA uses the modular plugin format (plugin model v2).
      All extensions are registered in the descriptors of the content modules listed below.
      Each content module is a Gradle subproject using the `org.jetbrains.intellij.platform.module` plugin.
      The descriptor of a module is located at `<subproject>/src/main/resources/<module name>.xml`.

      - nix-idea.core.shared:   Language basics, loaded in all IDEs and, in split mode, in both processes.
      - nix-idea.core.backend:  Core functionality which needs the project model, the file system or external processes.
      - nix-idea.core.frontend: Core UI which belongs to the frontend process (color settings page).
      - nix-idea.spellchecker:  Spellchecking support (only loaded if the IDE provides the spellchecker).
      - nix-idea.lsp:           Integration of language servers (only loaded if the IDE provides the LSP API).

      Split mode (remote development): Modules depending on intellij.platform.backend are only loaded in the
      backend process, modules depending on intellij.platform.frontend only in the frontend process, and modules
      depending on neither in both processes. In a monolithic IDE, all modules are loaded.

      IDE-specific functionality can be added as additional optional modules
      which declare a dependency on the corresponding IDE-specific plugin or module.
      -->
    <content>
        <module name="nix-idea.core.shared" loading="required"/>
        <module name="nix-idea.core.backend"/>
        <module name="nix-idea.core.frontend"/>
        <module name="nix-idea.spellchecker"/>
        <module name="nix-idea.lsp"/>
    </content>
</idea-plugin>
