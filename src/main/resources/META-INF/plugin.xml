<idea-plugin>
    <!--
      NixIDEA uses the modular plugin format (plugin model v2).
      All extensions are registered in the descriptors of the content modules listed below.
      Each content module is a Gradle subproject using the `org.jetbrains.intellij.platform.module` plugin.
      The descriptor of a module is located at `<subproject>/src/main/resources/<module name>.xml`.

      - NixIDEA.core: Functionality available in all IDEs.
      - NixIDEA.lsp:  Integration of language servers (only loaded if the IDE provides the LSP API).

      IDE-specific functionality can be added as additional optional modules
      which declare a dependency on the corresponding IDE-specific plugin or module.
      -->
    <content>
        <module name="NixIDEA.core" loading="required"/>
        <module name="NixIDEA.lsp"/>
    </content>
</idea-plugin>
