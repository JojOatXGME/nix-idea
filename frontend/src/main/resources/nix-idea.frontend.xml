<!--
  Descriptor of the content module "nix-idea.frontend".
  It contains the functionality which belongs to the UI process: the color settings page.
  The default colors (additionalTextAttributes) stay in nix-idea.core, so that both processes know them.
  In split mode, the module is only loaded in the frontend process because it depends on intellij.platform.frontend.
  In a monolithic IDE, both intellij.platform.frontend and intellij.platform.backend are available.
  -->
<idea-plugin>

    <dependencies>
        <module name="nix-idea.core"/>
        <module name="intellij.platform.frontend"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">

        <colorSettingsPage
                implementation="org.nixos.idea.settings.ui.NixColorSettingsPage"/>

    </extensions>

</idea-plugin>
