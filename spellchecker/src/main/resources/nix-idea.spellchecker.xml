<!--
  Descriptor of the content module "nix-idea.spellchecker".
  It is separated from nix-idea.core.shared so that the dependency on intellij.spellchecker
  does not prevent nix-idea.core.shared from being loaded in processes without the spellchecker.
  -->
<idea-plugin>

    <dependencies>
        <module name="nix-idea.core.shared"/>
        <module name="intellij.spellchecker"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">

        <spellchecker.support
                language="Nix"
                implementationClass="org.nixos.idea.lang.NixSpellcheckingStrategy"/>

    </extensions>

</idea-plugin>
